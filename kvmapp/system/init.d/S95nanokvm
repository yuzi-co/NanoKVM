#!/bin/sh
# nanokvm Rev3.1

# libkvm reports a capture pipeline that does not start with printf, and the
# server used to send that output nowhere: to the console at boot, and to
# /dev/null after a scripted restart. Both are lost, so every earlier attempt
# to explain the intermittent failure had no error code to work from.
#
# Send the output to tmpfs instead. S99vidiag follows this file and copies the
# few lines that matter to /data, which survives a reboot. The path is under
# /tmp because /kvmapp is the boot SD card.
#
# The server sets line buffering for stdout at startup. Without that the C
# messages wait in libc for the process to exit, and this file collects one
# line and then nothing. See server/common/libkvm_stdout.go.
#
# Empty the file before the copies below, not after them. libkvm prints on some
# error paths once per frame. A capture pipeline that fails in a loop therefore
# fills tmpfs, and the copy of /kvmapp/server then has no space for its 36MB. A
# copy that runs out of space leaves a truncated NanoKVM-Server, and the case
# starts it anyway. S99vidiag also empties this file, but only while its reader
# runs, so these cases must not depend on it.
SERVER_LOG=/tmp/nanokvm-server.log

wait_for_exit() {
    process="$1"
    timeout="$2"
    elapsed=0

    while pidof "$process" >/dev/null 2>&1; do
        if [ "$elapsed" -ge "$timeout" ]; then
            return 1
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

stop_process() {
    process="$1"

    if ! pidof "$process" >/dev/null 2>&1; then
        return
    fi

    killall -INT "$process" 2>/dev/null || true
    if wait_for_exit "$process" 20; then
        return
    fi

    killall -TERM "$process" 2>/dev/null || true
    if wait_for_exit "$process" 5; then
        return
    fi

    killall -KILL "$process" 2>/dev/null || true
    wait_for_exit "$process" 2 || true
}

stop_services() {
    # The server owns VI/VPSS. Let it release MMF before stopping kvm_system.
    stop_process NanoKVM-Server
    stop_process kvm_system
    rm -rf /tmp/kvm_system /tmp/server
}

# now_fps is rewritten whenever the measured frame rate changes, so a
# streaming session rewrites it for as long as it runs. The value means
# nothing across a reboot, and the card it lands on is the one the device
# boots from, so point the path at tmpfs and leave a symlink behind. Both
# readers keep the path they already use and neither needs rebuilding.
#
# kvm_system does not check the result of fopen before seeking on it, so a
# missing file crashes it. The target is created here, before anything reads
# it, and refreshed on restart in case tmpfs was cleared underneath us.
#
# state is the same shape of file. libkvm writes it from inside its frame read,
# with a shell, on every change of HDMI presence: "echo 1 > /kvmapp/kvm/state"
# when it starts getting frames and 0 when it stops. A source that comes and
# goes therefore writes to the boot medium on its own, with no user in the loop,
# and holds the capture mutex while it forks. The value describes this moment
# and means nothing after a reboot. kvm_system writes 0 into it at startup
# anyway, so tmpfs loses nothing.
#
# link_runtime_file points one of these names at tmpfs. It replaces a regular
# file with the link, so a board that has been running the old layout is
# converted on the next start.
link_runtime_file() {
    name=$1

    [ -e "/tmp/kvm/$name" ] || echo 0 > "/tmp/kvm/$name"

    if [ ! -L "/kvmapp/kvm/$name" ]; then
        rm -f "/kvmapp/kvm/$name"
        ln -s "/tmp/kvm/$name" "/kvmapp/kvm/$name"
    fi
}

prepare_runtime_state() {
    mkdir -p /tmp/kvm

    link_runtime_file now_fps
    link_runtime_file state
}

start_services() {
    prepare_runtime_state

    # Start each run with an empty file, so the log always describes the server
    # that is running now. S99vidiag has already copied what it read to /data.
    #
    # This runs before the copies below, not after them: a capture pipeline that
    # fails in a loop fills tmpfs, and the copy of /kvmapp/server then has no
    # room for its 36MB.
    : > "$SERVER_LOG"

    cp -r /kvmapp/kvm_system /tmp/
    if [ -f /kvmapp/kvm_new_app ]; then
        touch /tmp/.nanokvm_migrating
        /tmp/kvm_system/kvm_system &

        # The legacy migration invokes this init script recursively and starts
        # the server itself. Wait for that single migration path to finish.
        migration_wait=0
        while [ "$migration_wait" -lt 30 ]; do
            if [ ! -f /kvmapp/kvm_new_app ] && pidof NanoKVM-Server >/dev/null 2>&1; then
                rm -f /tmp/.nanokvm_migrating
                return
            fi
            sleep 1
            migration_wait=$((migration_wait + 1))
        done
        rm -f /tmp/.nanokvm_migrating
    else
        /tmp/kvm_system/kvm_system &
    fi

    if ! pidof NanoKVM-Server >/dev/null 2>&1; then
        rm -rf /tmp/server
        cp -r /kvmapp/server /tmp/
        /tmp/server/NanoKVM-Server >> "$SERVER_LOG" 2>&1 &
    fi
}

case "$1" in
  start)
    echo -n kvm > /boot/hostname.prefix

    # Copy sensor config if the file exists
    [ -f /mnt/data/sensor_cfg.ini.LT ] && cp /mnt/data/sensor_cfg.ini.LT /mnt/data/sensor_cfg.ini

    # Generate unique device key
    if [ -f /sys/class/cvi-base/base_uid ]; then
        str_value=$(awk '{print $2}' /sys/class/cvi-base/base_uid)
        first_uint=$(echo "$str_value" | cut -d'_' -f1)
        second_uint=$(echo "$str_value" | cut -d'_' -f2)
        echo "$first_uint$second_uint" > /device_key
    fi

    # Set iptables rules (skip if already present)
    iptables -C INPUT -i eth0 -p tcp --dport 80 -m state --state NEW,ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A INPUT -i eth0 -p tcp --dport 80 -m state --state NEW,ESTABLISHED -j ACCEPT

    iptables -C OUTPUT -o eth0 -p tcp --sport 80 -m state --state ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A OUTPUT -o eth0 -p tcp --sport 80 -m state --state ESTABLISHED -j ACCEPT

    iptables -C INPUT -i eth0 -p tcp --sport 22 -m state --state NEW,ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A INPUT -i eth0 -p tcp --sport 22 -m state --state NEW,ESTABLISHED -j ACCEPT

    iptables -C OUTPUT -o eth0 -p tcp --dport 22 -m state --state ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A OUTPUT -o eth0 -p tcp --dport 22 -m state --state ESTABLISHED -j ACCEPT

    iptables -C OUTPUT -o eth0 -p tcp --sport 8000 -m state --state ESTABLISHED -j DROP 2>/dev/null || \
    iptables -A OUTPUT -o eth0 -p tcp --sport 8000 -m state --state ESTABLISHED -j DROP

    # Never answer DHCP on the wired network. udhcpd serves the USB and the
    # WiFi AP subnets, but it listens for 255.255.255.255 broadcasts, and the
    # kernel does not reliably confine that to the interface it was bound to.
    # A NanoKVM plugged into an office LAN then offers addresses from its own
    # private subnet to any machine that asks, which breaks them.
    #
    # These match the server port only, so the DHCP client that gives this
    # device its own address is untouched: it sends and listens on port 68,
    # and acquires its first lease over a raw socket that never reaches these
    # chains. Insert at the top so no earlier accept can win.
    if [ ! -e /boot/dhcp.eth0 ]; then
        iptables -C INPUT -i eth0 -p udp --dport 67 -j DROP 2>/dev/null || \
        iptables -I INPUT -i eth0 -p udp --dport 67 -j DROP

        iptables -C OUTPUT -o eth0 -p udp --sport 67 -j DROP 2>/dev/null || \
        iptables -I OUTPUT -o eth0 -p udp --sport 67 -j DROP
    fi

    # Logo selection
    if [ -f /boot/logo.ico ]; then
        if [ ! -f /kvmapp/server/web/original.ico ]; then
            mv /kvmapp/server/web/sipeed.ico /kvmapp/server/web/original.ico
            cp /boot/logo.ico /kvmapp/server/web/sipeed.ico
        fi
    else
        if [ -f /kvmapp/server/web/original.ico ]; then
            mv /kvmapp/server/web/original.ico /kvmapp/server/web/sipeed.ico
        fi
    fi

    # Start services
    start_services
   ;;

  stop)
    stop_services
    echo "OK"
   ;;

  restart)
    if [ -f /tmp/.nanokvm_migrating ]; then
        exit 0
    fi
    stop_services
    start_services

    sync
    echo "OK"
   ;;
    
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
  ;;
esac
