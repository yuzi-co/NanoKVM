/dts-v1/;

/ {
	description = "Various kernels, ramdisks and FDT blobs";
	#address-cells = <0x00000002>;

	images {
		kernel-1 {
			description = "cvitek kernel";
			data = /incbin/("@KERNEL@");
			type = "kernel";
			arch = "riscv";
			os = "linux";
			compression = "none";
			load = <0x00000000 0x80200000>;
			entry = <0x00000000 0x80200000>;
			hash-2 {
				algo = "crc32";
			};
		};

		ramdisk-1 {
			description = "cvitek ramdisk";
			data = /incbin/("@RAMDISK@");
			type = "ramdisk";
			arch = "riscv";
			os = "linux";
			compression = "none";
			load = <0x00000000>;
			entry = <0x00000000>;
			hash-1 {
				algo = "crc32";
			};
		};

		fdt-sg2002_licheervnano_sd {
			description = "cvitek device tree - sg2002_licheervnano_sd";
			data = /incbin/("@FDT@");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			hash-1 {
				algo = "sha256";
			};
		};
	};

	configurations {
		config-sg2002_licheervnano_sd {
			description = "boot cvitek system with board sg2002_licheervnano_sd";
			kernel = "kernel-1";
			ramdisk = "ramdisk-1";
			fdt = "fdt-sg2002_licheervnano_sd";
		};
	};
};
