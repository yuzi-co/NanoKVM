#!/bin/sh
#
# Restart NanoKVM-Server and kvm_system if they die. Install as
# /etc/init.d/S98supervise, mode 755.
#
# Nothing else does. S95nanokvm starts both with `&`, and inittab respawns only
# two gettys, so a segfault leaves the KVM unreachable over HTTP until a person
# intervenes. On out-of-band management hardware that is the worst possible
# failure: the box exists to answer when the machine it controls does not.
#
# This is deliberately additive. It never starts the services at boot - that is
# still S95nanokvm's job - so if this script is wrong the worst it does is
# nothing. It does not modify S95nanokvm either, because that runs at boot and
# is not worth the risk for this.
#
# Telling a crash from a deliberate stop needs no new state. `S95nanokvm stop`
# kills the process and then removes /tmp/server, so:
#
#   binary staged, no process   -> it died, restart it
#   /tmp/server gone            -> someone stopped it, leave it alone
#
# Environment:
#   SUPERVISE_INTERVAL   seconds between checks   (default 5)
#   SUPERVISE_LOG        where events go          (default /data/supervise.log)

INTERVAL=${SUPERVISE_INTERVAL:-5}
# Seconds a process may be alive and not answering before it counts as hung. A
# minute is deliberately long: the cost of acting too early is killing a working
# KVM, and the cost of acting late is a few more seconds of an outage that has
# already happened.
HANG_AFTER=${SUPERVISE_HANG_AFTER:-60}
HEALTH_URL=${SUPERVISE_URL:-http://127.0.0.1/}
LOG=${SUPERVISE_LOG:-/data/supervise.log}
PIDFILE=/tmp/supervise.pid

SERVER_BIN=${SERVER_BIN:-/tmp/server/NanoKVM-Server}
SYSTEM_BIN=${SYSTEM_BIN:-/tmp/kvm_system/kvm_system}

# /data survives a reboot, which matters: the reason a board restarted itself is
# worth having after the fact, and /var/log is a symlink into tmpfs.
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"
}

# --- decide ---
# binary_present and process_running are the two questions. The binary being
# staged in /tmp is the operator's intent, because a deliberate stop removes it.
#
# The last case looks strange and is real: during `S95nanokvm restart` the old
# process can still be dying after /tmp/server has been removed. Treating that
# as a crash would race the restart and start a second server.
# A hang is the failure pidof cannot see: the process is up and not serving, which
# from outside looks healthiest of all. It gets its own verdict because the cure
# differs - a crash needs starting, a hang needs killing first.
#
# The response is to restart the server, not to reboot the board. A reboot costs
# 17 seconds, puts the boot path at risk, and can land on a slot carrying none of
# these protections. The hardware watchdog is the right tool only for a kernel
# lockup, where no userspace process can act at all.
#
# The threshold is deliberately generous and the default is inaction. A probe that
# cannot run, a slow start under heavy IO, a moment of SD contention - none of
# those is worth killing a working KVM for.
action() {
    if process_running; then
        if serving; then
            echo healthy
            return
        fi

        # The default lives here rather than only at the top of the file, so this
        # block stands alone when the test extracts it - and so the test measures
        # the threshold that actually ships.
        if [ "$(unhealthy_for)" -ge "${HANG_AFTER:-60}" ]; then
            echo hung
        else
            echo healthy
        fi

        return
    fi

    if binary_present; then
        echo restart
    else
        echo stopped
    fi
}
# --- end decide ---

# --- cure ---
# A hang has to be killed, not asked to stop. S95nanokvm's restart uses killall,
# which sends SIGTERM, and a wedged process may never act on it - it would keep
# port 80 and the replacement could not bind, so the hang would survive its own
# cure. SIGKILL first, wait for the process to actually go, then use the normal
# restart path so /tmp is re-staged and kvm_system comes with it.
cure_hung() {
    force_kill
    wait_gone
    full_restart
}
# --- end cure ---

# --- backoff ---
# A binary that can never start must not be retried in a tight loop: this board
# has one core and an SD card. It must also never be given up on, because it is
# the thing you reach for when nothing else answers - so the delay grows to a cap
# and stays there rather than stopping.
first_delay() {
    echo 5
}

next_delay() {
    d=$(( $1 * 2 ))
    [ "$d" -lt 5 ] && d=5
    [ "$d" -gt 60 ] && d=60
    echo "$d"
}

# delay_after_run picks the next delay from how long the service actually lasted.
# A run that held up means the fault was transient, so start over; otherwise a
# board that crashes once a day would creep to the cap and stay there, and the
# next real crash would wait a minute for nothing.
delay_after_run() {
    ran=$1
    current=$2

    if [ "$ran" -ge 60 ]; then
        first_delay
    else
        next_delay "$current"
    fi
}
# --- end backoff ---

binary_present() {
    [ -x "$SERVER_BIN" ]
}

process_running() {
    pidof NanoKVM-Server > /dev/null 2>&1
}

system_binary_present() {
    [ -x "$SYSTEM_BIN" ]
}

system_running() {
    pidof kvm_system > /dev/null 2>&1
}

# A 401 counts as serving: the process is up, has bound its port and read its
# config. If curl itself cannot run, this reports serving - never reboot or
# restart a KVM because a probe broke.
serving() {
    [ -x "$(command -v curl)" ] || return 0

    code=$(curl -sSk -o /dev/null -w '%{http_code}' --max-time 4 "$HEALTH_URL" 2>/dev/null)
    case "$code" in
        2??|3??|401) return 0 ;;
    esac
    return 1
}

now() {
    cut -d. -f1 /proc/uptime
}

force_kill() {
    killall -9 NanoKVM-Server 2>/dev/null
}

wait_gone() {
    i=0
    while [ "$i" -lt 10 ]; do
        process_running || return 0
        i=$((i + 1))
        sleep 1
    done
    return 1
}

full_restart() {
    setsid sh -c '/etc/init.d/S95nanokvm restart > /tmp/supervise-restart.log 2>&1' \
        < /dev/null > /dev/null 2>&1 &
}

# How long the server has been alive without answering. LAST_OK is maintained by
# the watch loop.
unhealthy_for() {
    echo $(( $(now) - LAST_OK ))
}

watch_loop() {
    delay=$(first_delay)
    started=$(now)
    LAST_OK=$(now)

    while :; do
        sleep "$INTERVAL"

        serving && LAST_OK=$(now)

        case "$(action)" in
            healthy)
                started=$(now)
                ;;

            hung)
                stuck=$(unhealthy_for)
                log "NanoKVM-Server is up but has not answered for ${stuck}s, killing and restarting it"
                cure_hung
                # Give it room to come up before judging again, or a slow start
                # would be read as another hang.
                sleep 30
                LAST_OK=$(now)
                started=$(now)
                ;;
            stopped)
                : # someone asked for this
                ;;
            restart)
                ran=$(( $(now) - started ))
                log "NanoKVM-Server is gone after ${ran}s, restarting in ${delay}s"
                sleep "$delay"

                # Check again: a restart in progress may have started it while
                # this was waiting.
                if [ "$(action)" = restart ]; then
                    "$SERVER_BIN" < /dev/null > /dev/null 2>&1 &
                    log "started $SERVER_BIN as pid $!"
                fi

                delay=$(delay_after_run "$ran" "$delay")
                started=$(now)
                LAST_OK=$(now)
                ;;
        esac

        # kvm_system drives the OLED and the hardware monitor. Losing it costs
        # no availability, so it gets a plain restart with no backoff.
        if ! system_running && system_binary_present; then
            "$SYSTEM_BIN" < /dev/null > /dev/null 2>&1 &
            log "kvm_system was gone, started it as pid $!"
        fi
    done
}

start() {
    printf "supervise: "

    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "already running (pid $(cat "$PIDFILE"))"
        return 0
    fi

    # setsid, not just redirected fds. Backgrounding the loop with its stdio on
    # /dev/null looks sufficient and is not: measured over ssh, `start` printed
    # its line and then held the session open until the client gave up. A new
    # session detaches it properly. S95nanokvm's own restart needs the same
    # treatment, and tools/build/README.md records why.
    setsid "$0" __watch < /dev/null > /dev/null 2>&1 &
    echo "$!" > "$PIDFILE"

    log "supervisor started as pid $!, checking every ${INTERVAL}s"
    echo "OK (pid $!, every ${INTERVAL}s)"
}

stop() {
    printf "supervise: "

    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        log "supervisor stopped"
        echo "stopped"
    else
        echo "not running"
    fi
}

case "$1" in
    __watch)
        # Internal: the detached loop re-enters here through setsid.
        watch_loop
        ;;
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "supervisor : running (pid $(cat "$PIDFILE"))"
        else
            echo "supervisor : not running"
        fi
        LAST_OK=$(now); serving || LAST_OK=0
        echo "verdict    : $(action)"
        echo "answering  : $(serving && echo yes || echo no)"
        echo "server     : $(process_running && echo up || echo down)"
        echo "kvm_system : $(system_running && echo up || echo down)"
        echo "recent     :"
        tail -5 "$LOG" 2>/dev/null | sed 's/^/  /'
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
